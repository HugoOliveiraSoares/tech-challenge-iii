    {
      "name": "pedido",
      "item": [
        {
          "name": "Criar pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    if (body.id) {",
                  "        pm.collectionVariables.set('orderId', body.id);",
                  "        console.log('orderId salvo:', body.id);",
                  "    }",
                  "}",
                  "",
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantId\": \"rest-001\",\n  \"itens\": [\n    {\n      \"productId\": 1,\n      \"name\": \"X-Burger\",\n      \"quantity\": 2,\n      \"price\": 25.90\n    },\n    {\n      \"productId\": 2,\n      \"name\": \"Refrigerante\",\n      \"quantity\": 1,\n      \"price\": 5.50\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8082/pedidos",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8082",
              "path": [
                "pedidos"
              ]
            },
            "description": "Cria um novo pedido para o cliente autenticado (ID extraído do JWT).\n\n**201 Created** — corpo com pedido completo; header `Location: /pedidos/{id}`.\n\n**400** — validação (itens vazios, quantidade inválida, etc.).\n**401** — token ausente ou inválido."
          },
          "response": []
        },
        {
          "name": "Buscar pedido por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8082/pedidos/{{orderId}}",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8082",
              "path": [
                "pedidos",
                "{{orderId}}"
              ]
            },
            "description": "Retorna um pedido pelo UUID.\n\nSó retorna pedidos do cliente logado (mesmo `clientId` do JWT).\n\n**200** — pedido encontrado.\n**404** — pedido inexistente ou de outro cliente.\n**401** — não autenticado."
          },
          "response": []
        },
        {
          "name": "Listar pedidos do cliente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8082/pedidos",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8082",
              "path": [
                "pedidos"
              ]
            },
            "description": "Lista todos os pedidos do cliente autenticado, ordenados por data (mais recentes primeiro).\n\nResposta: `{ \"orders\": [ { \"id\", \"status\", \"totalPrice\", \"createdAt\" } ] }`"
          },
          "response": []
        }
      ]
    }
